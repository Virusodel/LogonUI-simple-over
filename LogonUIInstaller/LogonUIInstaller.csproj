<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="AxInterop.WMPLib">
      <HintPath>..\Resources\AxInterop.WMPLib.dll</HintPath>
    </Reference>
    <Reference Include="Interop.WMPLib">
      <HintPath>..\Resources\Interop.WMPLib.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LogonUI.exe" LogicalName="LogonUI.exe" />
    <EmbeddedResource Include="wd.webp" LogicalName="wd.webp" />
    <EmbeddedResource Include="fg.ani" LogicalName="fg.ani" />
    <EmbeddedResource Include="hr.gif" LogicalName="hr.gif" />
    <EmbeddedResource Include="vd.mp4" LogicalName="vd.mp4" />
    <EmbeddedResource Include="kj.mp4" LogicalName="kj.mp4" />
    <EmbeddedResource Include="kf.mp4" LogicalName="kf.mp4" />
    <EmbeddedResource Include="dv.mp3" LogicalName="dv.mp3" />
    <!-- DLL для WMP -->
    <EmbeddedResource Include="AxInterop.WMPLib.dll" LogicalName="AxInterop.WMPLib.dll" />
    <EmbeddedResource Include="Interop.WMPLib.dll" LogicalName="Interop.WMPLib.dll" />
  </ItemGroup>
</Project>
